class Solution {
    public int minOperations(String s) {
        int n = s.length();

        boolean sorted = true;

        for (int i = 1; i < n; i++) {
            if (s.charAt(i) < s.charAt(i - 1)) {
                sorted = false;
                break;
            }
        }

        if (sorted) {
            return 0;
        }

        if (n == 2) {
            return -1;
        }

        char first = s.charAt(0);
        char last = s.charAt(n - 1);

        char max = maxChar(s);
        char min = minChar(s);

        if (first == min || last == max) {
            return 1;
        }

        if (first == max && last == min) {
            int firstCount = 0;
            int lastCount = 0;

            for (int i = 0; i < n; i++) {
                if (s.charAt(i) == first) {
                    firstCount++;
                }
                if (s.charAt(i) == last) {
                    lastCount++;
                }
            }

            if (firstCount == 1 && lastCount == 1) {
                return 3;
            }
        }

        return 2;
    }

    private char maxChar(String s) {
        char max = 'a';
        for (int i = 0; i < s.length(); i++) {
            max = (char) Math.max(max, s.charAt(i));
        }
        return max;
    }

    private char minChar(String s) {
        char min = 'z';
        for (int i = 0; i < s.length(); i++) {
            min = (char) Math.min(min, s.charAt(i));
        }
        return min;
    }
}
