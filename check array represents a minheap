class Solution {
    public boolean isHeap(int[] nums) {
        int n=nums.length;
        for(int i=0;i<nums.length/2;i++)
        {   int l=2*i+1;
            int r=2*i+2;
            if(l<n && nums[i]>nums[l])
                return false;
            if(r<n && nums[i]>nums[r])
                return false;
        }
        return true;

    }
}
