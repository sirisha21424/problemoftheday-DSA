class Solution {
    public int maxEqualSum(ArrayList<Integer> s1, ArrayList<Integer> s2,
                           ArrayList<Integer> s3) {
        // code here
        int sum1=0;
        int sum2=0;
        int sum3=0;
        int n1=s1.size();
        int n2=s2.size();
        int n3=s3.size();
        for(int i=0;i<n1;i++)
        {   sum1+=s1.get(i);
        }
        for(int i=0;i<n2;i++)
        {   sum2+=s2.get(i);
        }
        for(int i=0;i<n3;i++)
        {   sum3+=s3.get(i);
        }
        int i=0,j=0,k=0;
        while(true)
        {   if(sum1==sum2 && sum2==sum3)
            {   return sum1;
            }
            if(i==n1 && j==n2 && k==n3)
                return 0;
            if(sum1>=sum2 && sum1>=sum3 && i<n1)
            {   sum1-=s1.get(i);
                i++;
            }
            else if(sum2>=sum1 && sum2>=sum3 && j<n2)
            {   sum2-=s2.get(j);
                j++;
            }
            else
            {   if(k<n3)
                {   sum3-=s3.get(k);
                    k++;
                }
            }
            
        }
    
            
        
        
    }
}
