class Solution {
    public int rowWithMax1s(int[][] mat) {
        int index=-1;
        int max=0;
        int m=mat[0].length;
        for(int i=0;i<mat.length;i++)
        {   int count=0;
            for(int j=m-1;j>=0;j--)
            {   if(mat[i][j]==1)
                {   count+=1;
                }
                else
                    break;
            }
            if(max<count)
            {   max=count;
                index=i;
            }
        }
        return index;
       
    }
}
