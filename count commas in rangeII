class Solution {
    public long countCommas(long n) {
        long tot = 0;

        if (n >= 1 && n <= 999) {
            tot = 0;
        }
        else if (n >= 1000 && n <= 999999) {
            tot = n - 999;
        }
        else if (n >= 1000000 && n <= 999999999) {
            tot = 999000 + 2 * (n - 999999);
        }
        else if (n >= 1000000000L && n <= 999999999999L) {
            tot = 999000 + 2 * 999000000L
                    + 3 * (n - 999999999);
        }
        else if (n >= 1000000000000L && n <= 999999999999999L) {
            tot = 999000 + 2 * 999000000L
                    + 3 * 999000000000L
                    + 4 * (n - 999999999999L);
        }
        else {
    tot = 999000
            + 2 * 999000000L
            + 3 * 999000000000L
            + 4 * 999000000000000L
            + 5 * (n - 999999999999999L);
    }
        return tot;

        
    }
}
