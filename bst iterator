class BSTIterator {
    ArrayList<Integer> list=new ArrayList<>();
    int pointer=-1;

    public BSTIterator(TreeNode root) {
        inorder(root);

        
    }
    public void inorder(TreeNode root)
    {   if(root==null)
        {   return ;
        }
        inorder(root.left);
        list.add(root.data);
        inorder(root.right);
    }
    
    public boolean hasNext() {
       
        return pointer+1<list.size();
        
    }
    
    public int next() {
        pointer++;
        return list.get(pointer);
        
    }
    
    public boolean hasPrev() {
        return pointer-1>=0;
        
    }
    
    public int prev() {
        pointer--;
         return list.get(pointer);
        
    }
}
