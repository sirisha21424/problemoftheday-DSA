class Solution {
    public int sumCounts(List<Integer> nums) {
        int sum=0;
        int i=0;
        int n=nums.size();
        while(i<n)
        {   HashSet<Integer> set=new HashSet<>();
            for(int j=i;j<n;j++)
            {   set.add(nums.get(j));
                int count=set.size();
                sum+=count*count;
            }
            i++;
        }
        return sum;

        
    }
}
