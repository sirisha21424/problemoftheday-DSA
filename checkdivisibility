class Solution {
    public boolean checkDivisibility(int n) {
        int i=n;
        int sum=0;
        int pro=1;
        while(i>0)
        {   int r=i%10;
            pro*=r;
            sum+=r;
            i=i/10;
        }
        int tot=pro+sum;
        if(n%tot==0)
            return true;
        return false;
        
    }
}
