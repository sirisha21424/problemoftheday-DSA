class Solution {
    public int minimumSumSubarray(List<Integer> nums, int l, int r) {
        int n=nums.size();
        int mini=Integer.MAX_VALUE;
        for(int i=0;i<n;i++)
        {    int sum=0;
             int count=0;   
            for(int j=i;j<n;j++)
            {   sum+=nums.get(j);
                count++;
                if(count>=l && count<=r && sum>0)
                {   mini=Math.min(mini,sum);
                }
            }
        }
        if(mini==Integer.MAX_VALUE)
            return -1;
        return mini;

        
    }
}
