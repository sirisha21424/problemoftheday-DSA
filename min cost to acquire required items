class Solution {
    public long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        long first=(long)need1*cost1+(long)need2*cost2;
        long second=(long)Math.max(need1,need2)*costBoth;
        long third=(long)Math.min(need1,need2)*costBoth+(long)(need1-Math.min(need1,need2))*cost1+(long)(need2-Math.min(need1,need2))*cost2;
        return Math.min(first,Math.min(second,third));
        
    }
}
