class BSTIterator {
        Stack<TreeNode> st=new Stack<>();
        public BSTIterator(TreeNode root) {
            pushLeft(root);
           
        }

    public void pushLeft(TreeNode root) {
        while(root != null) {
            st.push(root);
            root = root.left;
        }
    }

        public boolean hasNext() {
            return !st.isEmpty();
        }

        public int next() {
            TreeNode node=st.pop();
             pushLeft(node.right);
             return node.data;
        }
}
