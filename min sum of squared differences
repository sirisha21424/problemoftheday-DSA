
class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        int n = nums1.length;
        long k = (long) k1 + k2;
        int[] diff = new int[n];
        int max = 0;
        long total = 0;

        for (int i = 0; i < n; i++) {
            diff[i] = Math.abs(nums1[i] - nums2[i]);
            max = Math.max(max, diff[i]);
            total += diff[i];
        }

        if (k >= total)
            return 0;

        int low = 0, high = max;

        while (low < high) {
            int mid = low + (high - low) / 2;
            long operations = 0;

            for (int i = 0; i < n; i++) {
                if (diff[i] > mid)
                    operations += diff[i] - mid;
            }

            if (operations <= k)
                high = mid;
            else
                low = mid + 1;
        }

        int limit = low;
        long operations = 0;
        long sum = 0;

        for (int i = 0; i < n; i++) {
            if (diff[i] > limit) {
                operations += diff[i] - limit;
                diff[i] = limit;
            }

            sum += (long) diff[i] * diff[i];
        }

        long remaining = k - operations;
        sum -= remaining * (2L * limit - 1);

        return sum;
    }
}
