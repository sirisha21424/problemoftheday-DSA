class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int n=nums.length;
        int maxx=0;
        if(n==1)
            return 1;
        int count1=1;
        int count2=1;
        for(int i=1;i<n;i++)
        {   if(nums[i]>nums[i-1])
            {   count1++;
                count2=1;
            }
            else if(nums[i]<nums[i-1])
            {   count2++;
                count1=1;
            }
            else
            {   count1=1;
                count2=1;
            }
            maxx=Math.max(maxx,Math.max(count1,count2));
        }
        return maxx;

        
    }
}
