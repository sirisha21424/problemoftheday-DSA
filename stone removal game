class Solution {
    public boolean canAliceWin(int n) {
            int k=10;
            if(n<10)
                return false;
            else
            {   while(n>0)
                {   n=n-k;
                    if(n<0)
                    {   return false;
                    }
                    n-=k-1;
                    k=k-2;
                    if(n<0)
                    {   return true;
                    }
                }
            }
            return false;
        
    }
}
