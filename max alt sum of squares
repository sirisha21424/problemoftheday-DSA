class Solution {
    public long maxAlternatingSum(int[] nums) {
        for (int i = 0; i < nums.length; i++) {
            nums[i] = Math.abs(nums[i]);
        }
        Arrays.sort(nums);
        long total=0;
        int k=nums.length/2;
        long min=0;
        long max=0;
        for(int i=0;i<k;i++)
        {   min+=(long)nums[i]*nums[i];
        }
        for(int i=k;i<nums.length;i++)
        {   max+=(long)nums[i]*nums[i];
        }
        return max-min;
        
    }
}
