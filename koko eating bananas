class Solution {
    public int minimumRateToEatBananas(int[] nums, int h) {
         int max=nums[0];
        for(int i=0;i<nums.length;i++)
        {   if(nums[i]>max)
            {   max=nums[i];
            }
        }
        int low=1;
        int anss=0;
        int high=max;
        long totalhrs=0;
        while(low<=high)
        {   int mid=low+(high-low)/2;
            totalhrs=findtotal(nums,mid);
            if(totalhrs<=h)
            {   anss=mid;
                high=mid-1;
            }
            else 
            {   low=mid+1;
            }
        }
        return anss;
    }
        public long findtotal(int [] arr,int hours)
        {   long totalhours=0;
            for(int i=0;i<arr.length;i++)
            {   totalhours+=((arr[i]+hours-1)/hours);
            }
            return totalhours;
    }
}
