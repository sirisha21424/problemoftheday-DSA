class Solution {
    public List<Integer> removeDuplicates(List<Integer> arr) {
        // Your code goes here
        LinkedHashSet<Integer> set = new LinkedHashSet<>();

        for (int i = 0; i < arr.size(); i++) {
            set.add(arr.get(i));
        }

        List<Integer> list = new ArrayList<>(set);

        return list;
    }
}
