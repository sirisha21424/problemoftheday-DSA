class Solution {
    public int countServers(int[][] grid) {
        int n=grid.length;
        int m=grid[0].length;
        int count=0;
        for(int i=0;i<n;i++)
        {   for(int j=0;j<m;j++)
            {   if(grid[i][j]==1)
                {  int c1=row(grid,i);
                    int c2=col(grid,j);
                    if(c1>1 || c2>1)
                    {   count+=1;
                    }
                   
                }
            }
        }
        return count;

        
    }
    public int row(int[][] grid,int r)
    {   int n=grid[0].length;
        int cc=0;
        for(int i=0;i<n;i++)
        {   if(grid[r][i]==1)
            {   cc+=1;
            }
        }
        return cc;
    }
    public int col(int[][] grid,int c)
    {   int n=grid.length;
        int cc=0;
        for(int i=0;i<n;i++)
        {   if(grid[i][c]==1)
            {   cc+=1;
            }
        }
        return cc;
    }

}
